    {
      "name": "03_Flight_Booking_Positive_Flow",
      "item": [
        {
          "name": "03.1 Search Flights (LHR to JFK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Matching flights found with available seats', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.total_matches).to.be.at.least(1);",
                  "    var flight = json.flights[0];",
                  "    pm.expect(flight.flight_number).to.eql('BA-178');",
                  "    pm.expect(flight.available_seats).to.be.above(0);",
                  "    pm.environment.set('test_flight_id', flight.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/flights/search?origin=LHR&destination=JFK",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "flights", "search"],
              "query": [
                {"key": "origin", "value": "LHR"},
                {"key": "destination", "value": "JFK"}
              ]
            }
          }
        },
        {
          "name": "03.2 Create Flight Booking (Dynamic Chaining)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate unique passport and random seat",
                  "var randomNum = Math.floor(100000 + Math.random() * 900000);",
                  "var passport = 'US' + randomNum;",
                  "var seatRow = Math.floor(10 + Math.random() * 20);",
                  "var seat = seatRow + 'C';",
                  "pm.environment.set('temp_passport', passport);",
                  "pm.environment.set('temp_seat', seat);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Booking created and booking_ref saved to environment', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.booking_ref).to.match(/^BK-[A-Z0-9]{6}$/);",
                  "    pm.expect(json.status).to.eql('CONFIRMED');",
                  "    pm.environment.set('booking_ref', json.booking_ref);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flight_id\": 2,\n  \"seat_number\": \"{{temp_seat}}\",\n  \"passenger\": {\n    \"first_name\": \"Postman\",\n    \"last_name\": \"Tester\",\n    \"email\": \"postman.tester@automation-qa.org\",\n    \"passport_number\": \"{{temp_passport}}\",\n    \"phone\": \"+1 555 987 6543\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings"]
            }
          }
        },
        {
          "name": "03.3 Get Booking by Reference (Chained Variable)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Retrieved booking matches chained reference', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.booking_ref).to.eql(pm.environment.get('booking_ref'));",
                  "    pm.expect(json.passenger_email).to.eql('postman.tester@automation-qa.org');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings/{{booking_ref}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings", "{{booking_ref}}"]
            }
          }
        },
        {
          "name": "03.4 Cancel Booking (Refund & Inventory Release)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Booking cancelled with refund amount', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('CANCELLED');",
                  "    pm.expect(json.refund_amount).to.be.above(0);",
                  "    pm.expect(json.cancelled_at).to.not.be.null;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings/{{booking_ref}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings", "{{booking_ref}}"]
            }
          }
        }
      ]
    },
