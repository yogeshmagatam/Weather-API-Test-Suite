    {
      "name": "05_Weather_Flight_Integration",
      "item": [
        {
          "name": "05.1 Destination Weather Advisory - Tokyo Typhoon (GROUNDED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Aviation advisory evaluates severe typhoon to GROUNDED', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.destination).to.eql('HND');",
                  "    pm.expect(json.destination_city).to.eql('Tokyo');",
                  "    pm.expect(json.advisory_status).to.eql('GROUNDED');",
                  "    pm.expect(json.active_alerts_count).to.be.at.least(1);",
                  "    pm.expect(json.recommendation).to.include('Visual approach suspended');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/flights/7/weather-advisory",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "flights", "7", "weather-advisory"]
            }
          }
        },
