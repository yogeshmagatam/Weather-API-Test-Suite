  "item": [
    {
      "name": "01_Weather_API_Positive_Cases",
      "item": [
        {
          "name": "01.1 Get Current Weather (London - Metric Default)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response time is under 300ms SLA', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(300);",
                  "});",
                  "pm.test('Schema validation: Location & metric units', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.location.city).to.eql('London');",
                  "    pm.expect(json.unit).to.eql('°C');",
                  "    pm.expect(json.wind_unit).to.eql('km/h');",
                  "    pm.expect(json.temperature).to.be.a('number');",
                  "    pm.expect(json.humidity_pct).to.be.within(0, 100);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/weather/current?city=London",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "weather", "current"],
              "query": [{"key": "city", "value": "London"}]
            }
          }
        },
        {
          "name": "01.2 Get Current Weather (New York - Imperial Units)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Imperial units converted correctly (°F, mph, miles)', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.location.city).to.eql('New York');",
                  "    pm.expect(json.unit).to.eql('°F');",
                  "    pm.expect(json.wind_unit).to.eql('mph');",
                  "    pm.expect(json.visibility_unit).to.eql('miles');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/weather/current?city=New York&units=imperial",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "weather", "current"],
              "query": [
                {"key": "city", "value": "New York"},
                {"key": "units", "value": "imperial"}
              ]
            }
          }
        },
        {
          "name": "01.3 Get 5-Day Weather Forecast (Paris)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Forecast contains exactly 5 chronological daily projections', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.forecast_days).to.eql(5);",
                  "    pm.expect(json.forecast.length).to.eql(5);",
                  "    json.forecast.forEach(function(day) {",
                  "        pm.expect(day).to.have.property('date');",
                  "        pm.expect(day.max_temp).to.be.at.least(day.min_temp);",
                  "        pm.expect(day.chance_of_rain_pct).to.be.within(0, 100);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/weather/forecast?city=Paris&days=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "weather", "forecast"],
              "query": [
                {"key": "city", "value": "Paris"},
                {"key": "days", "value": "5"}
              ]
            }
          }
        },
        {
          "name": "01.4 Get Active Weather Hazard Alerts",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns list of active alerts with required fields', function () {",
                  "    var alerts = pm.response.json();",
                  "    pm.expect(alerts).to.be.an('array');",
                  "    pm.expect(alerts.length).to.be.at.least(1);",
                  "    var alert = alerts[0];",
                  "    pm.expect(alert).to.have.property('severity');",
                  "    pm.expect(alert).to.have.property('headline');",
                  "    pm.expect(alert).to.have.property('instructions');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/weather/alerts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "weather", "alerts"]
            }
          }
        },
        {
          "name": "01.5 Ingest Weather Observation (Authorized)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Ingestion confirmed with new record_id', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('SUCCESS');",
                  "    pm.expect(json.record_id).to.be.a('number');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "X-API-Key", "value": "{{apiKey}}", "type": "text"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"city_name\": \"London\",\n  \"temp_c\": 17.5,\n  \"humidity\": 68,\n  \"wind_kph\": 14.5,\n  \"wind_direction\": \"SW\",\n  \"pressure_mb\": 1015.0,\n  \"visibility_km\": 10.0,\n  \"condition\": \"Partly Cloudy\",\n  \"condition_code\": 1003,\n  \"uv_index\": 3.5,\n  \"air_quality_index\": 25\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/weather/observations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "weather", "observations"]
            }
          }
        }
      ]
    },
