    {
      "name": "04_Station_Ingestion_and_Management",
      "item": [
        {
          "name": "04.1 List All Weather Station Cities",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Catalog contains at least 10 stations', function () {",
                  "    var cities = pm.response.json();",
                  "    pm.expect(cities.length).to.be.at.least(10);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/weather/cities",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "weather", "cities"]
            }
          }
        },
        {
          "name": "04.2 Ingest Weather Observation (Authorized)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Ingestion confirmed with new record_id', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('SUCCESS');",
                  "    pm.expect(json.record_id).to.be.a('number');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "X-API-Key", "value": "{{apiKey}}", "type": "text"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"city_name\": \"London\",\n  \"temp_c\": 17.5,\n  \"humidity\": 68,\n  \"wind_kph\": 14.5,\n  \"wind_direction\": \"SW\",\n  \"pressure_mb\": 1015.0,\n  \"visibility_km\": 10.0,\n  \"condition\": \"Partly Cloudy\",\n  \"condition_code\": 1003,\n  \"uv_index\": 3.5,\n  \"air_quality_index\": 25\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/weather/observations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "weather", "observations"]
            }
          }
        }
      ]
    },
    {
      "name": "05_Negative_Validation_Cases",
      "item": [
        {
          "name": "05.1 Missing City Parameter (422 Unprocessable)",
          "event": [
