          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/weather/current?city=AtlantisLostCity",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "weather", "current"],
              "query": [{"key": "city", "value": "AtlantisLostCity"}]
            }
