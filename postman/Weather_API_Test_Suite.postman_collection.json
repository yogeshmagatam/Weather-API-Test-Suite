    {
      "name": "06_Security_and_SQLi_Resilience",
      "item": [
        {
          "name": "06.1 SQL Injection Attack Resilience (404 Sanitized)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404 (Sanitized parameterized lookup)', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test('No SQL syntax errors or 500 leakages', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error).to.eql('CITY_NOT_FOUND');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/weather/current?city=' OR '1'='1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "weather", "current"],
              "query": [{"key": "city", "value": "' OR '1'='1"}]
            }
          }
        },
        {
          "name": "06.2 SQL UNION Injection Resilience (404 Sanitized)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test('Safely handled by parameterized ORM query', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error).to.eql('CITY_NOT_FOUND');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/weather/current?city=London' UNION SELECT 1,2,3,4,5,6,7--",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "weather", "current"],
              "query": [{"key": "city", "value": "London' UNION SELECT 1,2,3,4,5,6,7--"}]
            }
          }
        }
      ]
    }
  ]
